{
  "name": "template",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:css": "sass src/scss:assets/css --style=compressed --no-source-map",
    "watch:css": "sass --watch src/scss:assets/css --style=compressed --no-source-map",
    "build:js": "esbuild src/js/**/*.js --outdir=assets/js --minify",
    "watch:js": "esbuild src/js/**/*.js --outdir=assets/js --minify --watch",
    "serve": "browser-sync start --proxy \"http://localhost/ai-project-starter-v2\" --files \"assets/**/*,templates/**/*,includes/**/*\"",
    "dev": "concurrently \"npm run watch:css\" \"npm run watch:js\" \"npm run serve\"",
    "build": "npm run build:css && npm run build:js"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@prettier/plugin-php": "^0.25.0",
    "browser-sync": "^3.0.4",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.1",
    "prettier": "^3.9.6",
    "sass": "^1.102.0"
  }
}
